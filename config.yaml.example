# NaumiAgent 配置文件（示例）
# 复制为 .naumi/config.yaml；密钥请存入系统凭据库或环境变量

models:
  provider: "kimi"
  # 可选：provider catalog 路径；相对路径以此配置文件所在目录为基准。
  # catalog_path: "providers.json"
  default_model: "openai/kimi-for-coding"
  fast_model: "openai/kimi-for-coding"
  reasoning_model: "openai/kimi-for-coding"
  # 模型思考强度；auto 表示不发送强度参数，使用供应商默认值。
  reasoning_effort: auto
  max_tokens: 4096
  temperature: 1.0
  api_base: "https://api.kimi.com/coding/v1"
  # 使用 `naumi configure` 写入系统凭据库，或通过 NAUMI_MODELS__API_KEY 注入。
  model_info:
    openai/kimi-for-coding:
      max_context: 256000
    # 直连模型可在这里声明经过当前 API/LiteLLM 验证的强度能力。
    # anthropic/claude-opus-4-6:
    #   reasoning_efforts: [low, medium, high, max]
    #   default_reasoning_effort: high
    #   reasoning_effort: high

memory:
  session_db_path: "data/sessions.db"
  vector_db_path: "data/chroma"
  compaction_threshold: 0.75

harness:
  runtime_heartbeat_retention:
    # 仅清理已超过保留期且机械判定为 offline/stopped/failed 的运行时心跳诊断记录。
    enabled: true
    retention_days: 7
    interval_seconds: 21600
    standby_retry_seconds: 60
    lease_seconds: 60
    scan_limit: 100
    catalog_limit: 200
  agent_publication_recovery:
    # 周期恢复已提交但尚未投递到 durable result inbox 的 Agent 终态结果。
    enabled: true
    interval_seconds: 30
    max_empty_backoff_seconds: 300
    max_failure_backoff_seconds: 300
    scan_limit: 100
    # 同一 publication 达到该 claim 次数后，认证隔离并继续处理后续 FIFO。
    max_attempts: 5
    jitter_ratio: 0.1
  stable_remote_finalization_result_return:
    # 仅在 Runtime 绑定 authenticated Result transport 后创建 Worker。
    enabled: true
    interval_seconds: 30
    max_empty_backoff_seconds: 300
    max_failure_backoff_seconds: 300
    journal_scan_limit: 20
    return_scan_limit: 20
    claim_lease_seconds: 60
    result_timeout_seconds: 20
    retry_base_seconds: 5
    retry_max_seconds: 300
    max_attempts: 8
    shutdown_drain_seconds: 25
    jitter_ratio: 0.1
  stable_remote_finalization_result_http_transport:
    # 安装端向 Control Plane 回传 signed Result；证书内容不得写入 YAML。
    enabled: false
    # 启用时取消以下注释，并使用固定 :ingest 路径。
    # endpoint_url: "https://control.example/v1/stable-finalization/results:ingest"
    # server_ca_path: "/secure/path/control-plane-ca.pem"
    # client_certificate_path: "/secure/path/installation.pem"
    # client_private_key_path: "/secure/path/installation.key"
    # server_certificate_sha256_pins:
    #   - "<current-control-plane-leaf-sha256>"
    #   - "<next-control-plane-leaf-sha256>"
    connect_timeout_seconds: 5
    request_timeout_seconds: 15
    max_response_bytes: 524288
  stable_remote_finalization_installation_daemon:
    # 显式前台启动：naumi stable-finalization-daemon
    # UI Runtime 在启用后不再自行启动 Result Worker，避免双 owner。
    enabled: false
    bind_host: "127.0.0.1"
    advertise_host: "localhost"
    port: 0
    # 启用时取消以下注释；只写路径和证书 pin，不写证书/私钥内容。
    # installation_member_id: "relpopmember_<24-hex>"
    # server_certificate_path: "/secure/path/installation-server.pem"
    # server_private_key_path: "/secure/path/installation-server.key"
    # control_plane_ca_path: "/secure/path/control-plane-ca.pem"
    # authorized_control_plane_certificate_sha256:
    #   - "<current-control-plane-client-leaf-sha256>"
    #   - "<next-control-plane-client-leaf-sha256>"
    max_request_bytes: 2097152
    tls_handshake_timeout_seconds: 5
    request_timeout_seconds: 20
    requests_per_minute: 120
    max_concurrent_requests: 32
    lease_seconds: 60
    renew_interval_seconds: 10
    heartbeat_interval_seconds: 10
    heartbeat_timeout_seconds: 30

search:
  # 实际 token 不写入 YAML；运行时从环境变量解析。
  provider_order: [brave, duckduckgo, browser]
  brave:
    enabled: true
    api_key_ref: "{env:BRAVE_SEARCH_API_KEY}"
    # 以下均为可选 Brave Web Search 参数。
    country: null
    search_lang: null
    ui_lang: null
    safesearch: moderate
    spellcheck: true
    freshness: null
    timeout_seconds: 10

# 交互式 naumi 始终把启动命令所在目录绑定为本轮工作区。
# 此字段保留给 API、部署等非交互高级场景；"." 表示进程当前目录。
workspace_root: "."

safety:
  permission_mode: "moderate"
  allowed_dirs:
    - "."
  # 累计预算默认不限，但仍会持续记录费用与 Token 用量。
  max_budget_usd: null
  max_input_tokens: null
  max_output_tokens: null
  max_turns: 50
  # 同一工具批次与进程内 Agent 执行分别限流；1 可用于串行排障。
  max_parallel_tools: 4
  max_parallel_agents: 4
  # 等待 Agent 的进程内硬上限；达到后新委派会明确拒绝，0 表示不允许等待。
  max_queued_agents: 64
  # 如需主动限额，可改为明确数值，例如：
  # max_budget_usd: 5.0
  # max_input_tokens: 500000
  # max_output_tokens: 50000

mcp:
  servers: {}

api:
  # 默认仅监听本机回环地址，避免默认暴露到局域网。
  # 只有在明确需要外部网络访问时，才可显式设置为 "0.0.0.0"，
  # 并务必同时配置 api_keys 和 cors_origins 进行加固。
  host: "127.0.0.1"
  # 默认端口 8765 与 Mac Workbench 本地 daemon 约定保持一致；
  # 如需使用其他端口，可显式覆盖或通过 --port 传入。
  port: 8765
  # 公开部署请配置，例如：["naumi-local-key-please-change"]
  api_keys: []
  cors_origins: ["*"]

browser_daemon:
  # 容器内默认关闭外部 daemon 适配；需要时可指向单独运行的服务。
  enabled: false
  base_url: "http://127.0.0.1:3005"
  project_dir: "/workspace/browser-debugging-daemon"

browser:
  # 同时执行的浏览器任务；每个任务使用独立运行时和产物目录。
  # 默认 2，范围 1-8；设为 1 可串行排障。
  max_concurrent_runs: 2
  # 保留的浏览器运行记录数量，范围 20-5000。
  run_history_limit: 200

log_level: "INFO"

# 会话引擎：naumi（内置 AgentEngine，默认）或 pi（外部 pi coding agent，
# 需要 `npm install -g @earendil-works/pi-coding-agent`）。
# 运行时可用 `naumi --engine pi` 临时覆盖。
engine:
  provider: naumi
  pi:
    # pi 可执行文件名或绝对路径。
    binary: pi
    # pi 的 provider/model，例如 zai-coding-cn / glm-4.7。
    provider: null
    model: null
    # 传给 pi 子进程的环境变量；值可用 "{env:NAME}" 引用现有变量，
    # 避免把密钥写进配置文件。
    env: {}
