# Copy to .env.public before starting the public deployment.

# Required model provider credential.
NAUMI_MODELS__API_KEY=replace-with-your-model-api-key
NAUMI_MODELS__API_BASE=https://api.kimi.com/coding/v1

# Required public client credential. Generate a random value and keep JSON syntax.
# PowerShell: $token = -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})
NAUMI_API__API_KEYS=["replace-with-a-long-random-client-token"]

# Same-origin Web2 does not need CORS. Add exact HTTPS origins only for separate clients.
NAUMI_API__CORS_ORIGINS=[]

# Public listener and the host directory mounted as the Agent workspace.
NAUMI_PUBLIC_BIND=0.0.0.0
NAUMI_PUBLIC_PORT=8080
NAUMI_WORKSPACE_PATH=./workspace

NAUMI_SAFETY__MAX_BUDGET_USD=5.0
HOST_UID=1000
HOST_GID=1000
